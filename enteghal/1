<!-- ===== Shaayno Hero + Glass Header (RTL) ===== -->
<style>
.sh-hero, .sh-hero * { box-sizing: border-box; }
.sh-hero {
  --sh-glass: rgba(255,255,255,.14);
  --sh-border: rgba(255,255,255,.35);
  position: relative; width: 100vw; max-width: 100vw;
  margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw);
  height: 100vh; min-height: 520px; overflow: hidden; direction: rtl;
  font-family: inherit;
}
.sh-hero picture, .sh-hero picture img {
  position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block;
}
.sh-hero::after { content:""; position:absolute; inset:0; background:linear-gradient(180deg,rgba(0,0,0,.35),rgba(0,0,0,.05) 40%,rgba(0,0,0,.25)); pointer-events:none; }

/* Header (glass) */
.sh-header {
  position: absolute; top: 18px; right: 3%; left: 3%; z-index: 10;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  padding: 10px 22px; border-radius: 22px;
  background: var(--sh-glass); border: 1px solid var(--sh-border);
  -webkit-backdrop-filter: blur(16px) saturate(160%); backdrop-filter: blur(16px) saturate(160%);
  box-shadow: 0 8px 32px rgba(0,0,0,.25);
}
.sh-logo img { height: 48px; width: auto; display: block; }
.sh-nav { display: flex; gap: 6px; list-style: none; margin: 0; padding: 0; }
.sh-nav a {
  display: block; padding: 8px 14px; border-radius: 12px; color: #fff; text-decoration: none;
  font-size: 15px; transition: background .2s;
}
.sh-nav a:hover { background: rgba(255,255,255,.22); }
.sh-actions { display: flex; align-items: center; gap: 10px; }

.sh-btn {
  position: relative; width: 42px; height: 42px; display: grid; place-items: center;
  border-radius: 50%; background: rgba(255,255,255,.18); border: 1px solid var(--sh-border);
  color: #fff; cursor: pointer; padding: 0; transition: background .2s;
}
.sh-btn:hover { background: rgba(255,255,255,.32); }
.sh-btn svg { width: 22px; height: 22px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.sh-badge {
  position: absolute; top: -4px; left: -4px; min-width: 19px; height: 19px; padding: 0 5px;
  border-radius: 10px; background: #e63946; color: #fff; font-size: 11px; line-height: 19px; text-align: center;
}

/* Dropdowns (hover on desktop, tap on touch) */
.sh-drop { position: relative; }
.sh-panel {
  position: absolute; top: calc(100% + 12px); left: 0; width: 300px; padding: 16px; border-radius: 18px;
  background: rgba(30,30,30,.55); border: 1px solid var(--sh-border); color: #fff;
  -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
  box-shadow: 0 12px 36px rgba(0,0,0,.35);
  opacity: 0; visibility: hidden; transform: translateY(8px); transition: .2s; font-size: 14px;
}
.sh-drop::after { content:""; position:absolute; top:100%; left:0; right:0; height:14px; } /* hover bridge */
.sh-drop:hover .sh-panel, .sh-drop.open .sh-panel { opacity: 1; visibility: visible; transform: none; }
.sh-panel h4 { margin: 0 0 10px; font-size: 15px; color: #fff; }
.sh-panel a.sh-link {
  display: block; padding: 9px 10px; border-radius: 10px; color: #fff; text-decoration: none;
}
.sh-panel a.sh-link:hover { background: rgba(255,255,255,.15); }
.sh-cta {
  display: block; text-align: center; margin-top: 10px; padding: 10px; border-radius: 12px;
  background: #fff; color: #111 !important; text-decoration: none; font-weight: 600;
}
.sh-item { display: flex; gap: 10px; align-items: center; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,.15); }
.sh-item img { width: 46px; height: 46px; border-radius: 10px; object-fit: cover; }
.sh-item div { flex: 1; min-width: 0; }
.sh-item b { display: block; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sh-item small { opacity: .8; }
.sh-total { display: flex; justify-content: space-between; padding-top: 10px; font-weight: 600; }
.sh-empty { opacity: .85; padding: 6px 0; }

/* Hamburger */
.sh-burger { display: none; }
.sh-mobile {
  display: none; position: absolute; top: 86px; right: 3%; left: 3%; z-index: 9; padding: 14px; border-radius: 20px;
  background: rgba(30,30,30,.55); border: 1px solid var(--sh-border);
  -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
}
.sh-mobile a { display: block; color: #fff; text-decoration: none; padding: 12px 14px; border-radius: 12px; }
.sh-mobile a:hover { background: rgba(255,255,255,.15); }
.sh-hero.menu-open .sh-mobile { display: block; }

@media (max-width: 900px) {
  .sh-nav { display: none; }
  .sh-burger { display: grid; }
  .sh-header { top: 12px; padding: 8px 14px; }
  .sh-logo img { height: 40px; }
  .sh-panel { width: 270px; left: -50px; }
}
</style>

<section class="sh-hero" id="shHero">
  <picture>
    <source media="(max-width: 767px)" srcset="https://shaayno.com/wp-content/uploads/2026/11/Duck-ai-image-2026-11-06-06-49.jpeg">
    <img src="https://shaayno.com/wp-content/uploads/2026/11/IMG_6105-1536x864.webp" alt="شایانو" fetchpriority="high">
  </picture>

  <header class="sh-header">
    <a class="sh-logo" href="https://shaayno.com/">
      <img src="https://shaayno.com/wp-content/uploads/2026/11/Photo-11-05-2026-20.31.webp" alt="شایانو">
    </a>

    <ul class="sh-nav">
      <li><a href="https://shaayno.com/">خانه</a></li>
      <li><a href="https://shaayno.com/%d9%81%d8%b1%d9%88%d8%b4%da%af%d8%a7%d9%87/">فروشگاه</a></li>
      <li><a href="https://shaayno.com/%d8%af%d8%b1%d8%a8%d8%a7%d8%b1%d9%87-%d9%85%d8%a7/">درباره ما</a></li>
      <li><a href="https://shaayno.com/%d8%aa%d9%85%d8%a7%d8%b3-%d8%a8%d8%a7-%d9%85%d8%a7/">تماس با ما</a></li>
      <li><a href="https://shaayno.com/%d8%b4%d8%b1%d8%a7%db%8c%d8%b7-%d9%88-%d9%82%d9%88%d8%a7%d9%86%db%8c%d9%86/">شرایط و قوانین</a></li>
    </ul>

    <div class="sh-actions">
      <!-- Account -->
      <div class="sh-drop" id="shAccount">
        <button class="sh-btn" aria-label="حساب کاربری">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg>
        </button>
        <div class="sh-panel" id="shAccountPanel"></div>
      </div>

      <!-- Cart -->
      <div class="sh-drop" id="shCart">
        <button class="sh-btn" aria-label="سبد خرید">
          <svg viewBox="0 0 24 24"><path d="M3 4h2l2.4 11h10.2L20 7H6"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>
          <span class="sh-badge" id="shCount">0</span>
        </button>
        <div class="sh-panel" id="shCartPanel"><div class="sh-empty">در حال بارگذاری...</div></div>
      </div>

      <!-- Hamburger -->
      <button class="sh-btn sh-burger" id="shBurger" aria-label="منو">
        <svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </header>

  <nav class="sh-mobile">
    <a href="https://shaayno.com/">خانه</a>
    <a href="https://shaayno.com/%d9%81%d8%b1%d9%88%d8%b4%da%af%d8%a7%d9%87/">فروشگاه</a>
    <a href="https://shaayno.com/%d8%af%d8%b1%d8%a8%d8%a7%d8%b1%d9%87-%d9%85%d8%a7/">درباره ما</a>
    <a href="https://shaayno.com/%d8%aa%d9%85%d8%a7%d8%b3-%d8%a8%d8%a7-%d9%85%d8%a7/">تماس با ما</a>
    <a href="https://shaayno.com/%d8%b4%d8%b1%d8%a7%db%8c%d8%b7-%d9%88-%d9%82%d9%88%d8%a7%d9%86%db%8c%d9%86/">شرایط و قوانین</a>
  </nav>
</section>

<script>
(function () {
  var hero = document.getElementById('shHero');
  var ACCOUNT = 'https://shaayno.com/%d8%ad%d8%b3%d8%a7%d8%a8-%da%a9%d8%a7%d8%b1%d8%a8%d8%b1%db%8c-%d9%85%d9%86/';
  var CART = 'https://shaayno.com/%d8%b3%d8%a8%d8%af-%d8%ae%d8%b1%db%8c%d8%af/';
  var CHECKOUT = 'https://shaayno.com/%d9%be%d8%b1%d8%af%d8%a7%d8%ae%d8%aa/';

  // Hamburger
  document.getElementById('shBurger').addEventListener('click', function () {
    hero.classList.toggle('menu-open');
  });

  // Tap-to-open dropdowns on touch devices
  ['shAccount', 'shCart'].forEach(function (id) {
    var el = document.getElementById(id);
    el.querySelector('.sh-btn').addEventListener('click', function (e) {
      if (window.matchMedia('(hover: none)').matches) {
        e.stopPropagation();
        var was = el.classList.contains('open');
        document.querySelectorAll('.sh-drop.open').forEach(function (d) { d.classList.remove('open'); });
        if (!was) el.classList.add('open');
      }
    });
  });
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.sh-drop')) document.querySelectorAll('.sh-drop.open').forEach(function (d) { d.classList.remove('open'); });
  });

  // Account status (WordPress adds "logged-in" to <body> for signed-in users)
  var logged = document.body.classList.contains('logged-in');
  document.getElementById('shAccountPanel').innerHTML = logged
    ? '<h4>وضعیت حساب: وارد شده‌اید ✓</h4>' +
      '<a class="sh-link" href="' + ACCOUNT + '">داشبورد حساب کاربری</a>' +
      '<a class="sh-link" href="' + ACCOUNT + 'orders/">سفارش‌های من</a>' +
      '<a class="sh-link" href="' + ACCOUNT + 'edit-account/">جزئیات حساب</a>' +
      '<a class="sh-link" href="' + ACCOUNT + 'customer-logout/">خروج</a>'
    : '<h4>وضعیت حساب: وارد نشده‌اید</h4>' +
      '<div class="sh-empty">برای مشاهده سفارش‌ها وارد شوید یا ثبت‌نام کنید.</div>' +
      '<a class="sh-cta" href="' + ACCOUNT + '">ورود / ثبت‌نام</a>';

  // Mini cart via WooCommerce Store API
  function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
  function fmt(n, p) {
    var v = Number(n) / Math.pow(10, p.currency_minor_unit || 0);
    return v.toLocaleString('fa-IR') + ' ' + (p.currency_symbol || '');
  }
  function loadCart() {
    fetch('/wp-json/wc/store/v1/cart', { credentials: 'same-origin' })
      .then(function (r) { if (!r.ok) throw 0; return r.json(); })
      .then(function (c) {
        document.getElementById('shCount').textContent = (c.items_count || 0).toLocaleString('fa-IR');
        var box = document.getElementById('shCartPanel');
        if (!c.items || !c.items.length) { box.innerHTML = '<h4>سبد خرید</h4><div class="sh-empty">سبد خرید شما خالی است.</div><a class="sh-cta" href="https://shaayno.com/%d9%81%d8%b1%d9%88%d8%b4%da%af%d8%a7%d9%87/">رفتن به فروشگاه</a>'; return; }
        var html = '<h4>سبد خرید شما</h4>';
        c.items.forEach(function (i) {
          var img = i.images && i.images[0] ? i.images[0].thumbnail : '';
          html += '<div class="sh-item">' + (img ? '<img src="' + img + '" alt="">' : '') +
                  '<div><b>' + esc(i.name) + '</b><small>' + Number(i.quantity).toLocaleString('fa-IR') + ' × ' + fmt(i.prices.price, i.prices) + '</small></div></div>';
        });
        html += '<div class="sh-total"><span>جمع کل</span><span>' + fmt(c.totals.total_price, c.totals) + '</span></div>' +
                '<a class="sh-cta" href="' + CART + '">مشاهده سبد خرید</a>' +
                '<a class="sh-cta" style="background:transparent;color:#fff!important;border:1px solid #fff" href="' + CHECKOUT + '">پرداخت</a>';
        box.innerHTML = html;
      })
      .catch(function () {
        document.getElementById('shCartPanel').innerHTML = '<h4>سبد خرید</h4><a class="sh-cta" href="' + CART + '">مشاهده سبد خرید</a>';
      });
  }
  loadCart();
  document.getElementById('shCart').addEventListener('mouseenter', loadCart);
  if (window.jQuery) jQuery(document.body).on('added_to_cart removed_from_cart', loadCart);
})();
</script>
<!-- ===== End ===== -->
