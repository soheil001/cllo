
<?php
require_once __DIR__ . '/auth_common.php';

$agency = ot_require_agency();

if ($_SERVER['REQUEST_METHOD'] === 'GET') {
    $stmt = $pdo->prepare('SELECT data FROM agencies WHERE id = ? LIMIT 1');
    $stmt->execute([$agency['id']]);
    $a = ot_decode_row(($stmt->fetch()['data'] ?? null));

    unset($a['password'], $a['password_hash']);

    $stmt = $pdo->prepare(
        'SELECT data FROM tours WHERE agency_id = ? ORDER BY created_at DESC'
    );
    $stmt->execute([$agency['id']]);

    $tours = [];
    foreach ($stmt->fetchAll() as $r) {
        $tours[] = ot_decode_row($r['data'] ?? null);
    }

    $stmt = $pdo->prepare(
        'SELECT data FROM bookings WHERE agency_id = ? ORDER BY created_at DESC'
    );
    $stmt->execute([$agency['id']]);

    $bookings = [];
    foreach ($stmt->fetchAll() as $r) {
        $bookings[] = ot_decode_row($r['data'] ?? null);
    }

    ot_json([
        'success' => true,
        'agency' => [
            'id' => $agency['id'],
            'loginId' => $agency['login_id'],
            'name' => $a['name'] ?? '',
            'code' => $a['code'] ?? $agency['login_id'],
            'owner' => $a['owner'] ?? '',
            'license' => $a['license'] ?? '',
            'phone1' => $a['phone1'] ?? '',
            'phone2' => $a['phone2'] ?? '',
            'phone3' => $a['phone3'] ?? '',
            'insurance' => $a['insurance'] ?? '',
            'address' => $a['address'] ?? '',
            'notes' => $a['notes'] ?? '',
            'baleChatId' => $a['baleChatId'] ?? ''
        ],
        'tours' => $tours,
        'bookings' => $bookings,
        'csrf' => $agency['csrf']
    ]);
}

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    header('Allow: GET, POST');
    ot_json([
        'success' => false,
        'error' => 'Method not allowed'
    ], 405);
}

ot_require_csrf($agency['csrf']);

$input = ot_read_json(2 * 1024 * 1024);
$action = $input['action'] ?? '';

/* فقط نام آژانس قابل تغییر است */
if ($action === 'update_profile') {
    $name = trim((string)($input['name'] ?? ''));

    if ($name === '' || mb_strlen($name, 'UTF-8') > 150) {
        ot_json([
            'success' => false,
            'error' => 'نام آژانس باید بین ۱ تا ۱۵۰ کاراکتر باشد'
        ], 400);
    }

    $stmt = $pdo->prepare(
        'SELECT data FROM agencies WHERE id = ? LIMIT 1'
    );
    $stmt->execute([$agency['id']]);
    $row = $stmt->fetch();

    if (!$row) {
        ot_json([
            'success' => false,
            'error' => 'اطلاعات آژانس پیدا نشد'
        ], 404);
    }

    $data = ot_decode_row($row['data'] ?? null);

    /* سایر اطلاعات بدون تغییر باقی می‌مانند */
    $data['name'] = $name;

    $json = json_encode(
        $data,
        JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR
    );

    $stmt = $pdo->prepare(
        'UPDATE agencies SET data = ? WHERE id = ?'
    );
    $stmt->execute([$json, $agency['id']]);

    ot_json([
        'success' => true,
        'message' => 'نام آژانس با موفقیت تغییر کرد',
        'name' => $name
    ]);
}

/* ثبت تور جدید */
if ($action === 'create_tour') {
    $name = trim((string)($input['name'] ?? ''));
    $destination = trim((string)($input['destination'] ?? ''));
    $type = (string)($input['type'] ?? '');
    $start = trim((string)($input['start'] ?? ''));
    $end = trim((string)($input['end'] ?? ''));

    $price = filter_var(
        $input['price'] ?? 0,
        FILTER_VALIDATE_INT
    );

    $capacity = filter_var(
        $input['capacity'] ?? 0,
        FILTER_VALIDATE_INT
    );

    if (
        $name === '' ||
        $destination === '' ||
        !in_array($type, ['in', 'out'], true) ||
        $price === false ||
        $price < 0 ||
        $capacity === false ||
        $capacity < 0
    ) {
        ot_json([
            'success' => false,
            'error' => 'نام، مقصد، نوع تور، قیمت و ظرفیت را صحیح وارد کنید'
        ], 400);
    }

    if (
        $start !== '' &&
        !preg_match('/^\d{4}-\d{2}-\d{2}$/', $start)
    ) {
        ot_json([
            'success' => false,
            'error' => 'تاریخ شروع نامعتبر است'
        ], 400);
    }

    if (
        $end !== '' &&
        !preg_match('/^\d{4}-\d{2}-\d{2}$/', $end)
    ) {
        ot_json([
            'success' => false,
            'error' => 'تاریخ پایان نامعتبر است'
        ], 400);
    }

    if ($start !== '' && $end !== '' && $end < $start) {
        ot_json([
            'success' => false,
            'error' => 'تاریخ پایان نمی‌تواند قبل از شروع باشد'
        ], 400);
    }

    $id = 'tr_' . bin2hex(random_bytes(10));

    $tour = [
        'id' => $id,
        'name' => $name,
        'destination' => $destination,
        'type' => $type,
        'agencyId' => $agency['id'],
        'agencyCode' => $agency['login_id'],
        'start' => $start,
        'end' => $end,
        'price' => $price,
        'capacity' => $capacity,
        'remaining' => $capacity,
        'features' => trim((string)($input['features'] ?? '')),
        'image' => trim((string)($input['image'] ?? '')),
        'gallery' => is_array($input['gallery'] ?? null)
            ? array_values($input['gallery'])
            : [],
        'description' => trim((string)($input['description'] ?? '')),
        'status' => 'active',
        'approval_status' => 'pending',
        'submitted_by_role' => 'agency',
        'createdAt' => time() * 1000
    ];

    $json = json_encode(
        $tour,
        JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR
    );

    $stmt = $pdo->prepare(
        "INSERT INTO tours
        (id, agency_id, status, data, approval_status, submitted_by_role)
        VALUES (?, ?, 'active', ?, 'pending', 'agency')"
    );

    $stmt->execute([
        $id,
        $agency['id'],
        $json
    ]);

    ot_json([
        'success' => true,
        'tour' => $tour,
        'message' => 'تور برای بررسی مدیریت ارسال شد'
    ]);
}

/* مدیریت وضعیت و برنامه زمانی تور */
if ($action === 'update_tour_schedule') {
    $id = trim((string)($input['id'] ?? ''));
    $start = trim((string)($input['start'] ?? ''));
    $end = trim((string)($input['end'] ?? ''));
    $status = (string)($input['status'] ?? 'active');

    if (
        $id === '' ||
        !in_array($status, ['active', 'inactive'], true) ||
        ($start !== '' && !preg_match('/^\d{4}-\d{2}-\d{2}$/', $start)) ||
        ($end !== '' && !preg_match('/^\d{4}-\d{2}-\d{2}$/', $end)) ||
        ($start !== '' && $end !== '' && $end < $start)
    ) {
        ot_json([
            'success' => false,
            'error' => 'اطلاعات وضعیت یا تاریخ نامعتبر است'
        ], 400);
    }

    $stmt = $pdo->prepare(
        'SELECT data, approval_status FROM tours
         WHERE id = ? AND agency_id = ? LIMIT 1'
    );

    $stmt->execute([$id, $agency['id']]);
    $row = $stmt->fetch();

    if (!$row) {
        ot_json([
            'success' => false,
            'error' => 'تور متعلق به این آژانس نیست یا پیدا نشد'
        ], 404);
    }

    $tour = ot_decode_row($row['data']);

    $tour['start'] = $start;
    $tour['end'] = $end;
    $tour['status'] = $status;

    $json = json_encode(
        $tour,
        JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR
    );

    $stmt = $pdo->prepare(
        'UPDATE tours SET status = ?, data = ?
         WHERE id = ? AND agency_id = ?'
    );

    $stmt->execute([
        $status,
        $json,
        $id,
        $agency['id']
    ]);

    ot_json([
        'success' => true,
        'tour' => $tour
    ]);
}

ot_json([
    'success' => false,
    'error' => 'عملیات ناشناخته است'
], 400);
