
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>پنل آژانس | آف‌تور۲۴</title>
<link href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" rel="stylesheet">
<style>
*{box-sizing:border-box}
body{margin:0;padding:20px;background:#f3f5f8;color:#182235;font-family:Vazirmatn,Tahoma}
main{max-width:1000px;margin:auto}
.card{background:white;border-radius:15px;padding:22px;margin-bottom:18px;box-shadow:0 5px 20px #00000008}
h1,h2{margin-top:0}
h1{font-size:25px}
h2{font-size:19px}
input,select,textarea{width:100%;padding:12px;border:1px solid #d8dee8;border-radius:9px;font:inherit;background:white}
textarea{min-height:90px;resize:vertical}
label{display:block;font-size:14px;margin:12px 0 6px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
button{font:inherit;border:0;border-radius:9px;padding:11px 18px;background:#173d67;color:white;cursor:pointer}
button:disabled{opacity:.5;cursor:not-allowed}
.secondary{background:#64748b}
.item{padding:14px 0;border-bottom:1px solid #eee}
.muted{color:#667085;font-size:14px}
.status{display:inline-block;padding:4px 10px;border-radius:20px;background:#fff2d5;color:#925b00;font-size:12px}
.status.approved{background:#dcfce7;color:#166534}
.status.rejected{background:#fee2e2;color:#991b1b}
#msg{margin-top:12px;white-space:pre-wrap}
.preview{display:flex;gap:10px;flex-wrap:wrap;margin-top:10px}
.preview img{width:95px;height:75px;object-fit:cover;border-radius:8px}
@media(max-width:600px){.grid{grid-template-columns:1fr}body{padding:10px}.card{padding:16px}}
</style>
</head>
<body>
<main>
<section class="card">
<h1>داشبورد آژانس آف‌تور۲۴</h1>
<p id="agency" class="muted">در حال دریافت اطلاعات...</p>
<button id="logout" class="secondary">خروج از حساب</button>
</section>

<section class="card">
<h2>ثبت تور جدید</h2>
<p class="muted">تور پس از ثبت برای بررسی و تأیید مدیریت ارسال می‌شود.</p>

<form id="tourForm">
<div class="grid">
<div>
<label>نام تور *</label>
<input name="name" required maxlength="150">
</div>
<div>
<label>مقصد *</label>
<input name="destination" required maxlength="150">
</div>
<div>
<label>نوع تور *</label>
<select name="type" required>
<option value="">انتخاب کنید</option>
<option value="in">تور داخلی</option>
<option value="out">تور خارجی</option>
</select>
</div>
<div>
<label>قیمت (تومان) *</label>
<input name="price" type="number" min="0" step="1" required>
</div>
<div>
<label>ظرفیت کل *</label>
<input name="capacity" type="number" min="1" max="100000" required>
</div>
<div>
<label>تاریخ شروع</label>
<input name="start" type="date">
</div>
<div>
<label>تاریخ پایان</label>
<input name="end" type="date">
</div>
</div>

<label>امکانات تور</label>
<textarea name="features" placeholder="مثلاً هتل، صبحانه، ترانسفر..."></textarea>

<label>توضیحات کامل تور</label>
<textarea name="description" placeholder="توضیحات تور را وارد کنید..."></textarea>

<label>تصویر اصلی تور *</label>
<input id="mainImage" type="file" accept="image/jpeg,image/png,image/webp" required>

<div id="mainPreview" class="preview"></div>

<label>تصاویر گالری (حداکثر ۵ تصویر)</label>
<input id="galleryImages" type="file" accept="image/jpeg,image/png,image/webp" multiple>

<div id="galleryPreview" class="preview"></div>

<p class="muted">فرمت JPG، PNG یا WEBP؛ حداکثر ۸ مگابایت برای هر تصویر.</p>

<button id="submitTour" type="submit">ثبت و ارسال تور برای تأیید</button>
<p id="msg" role="alert"></p>
</form>
</section>

<section class="card">
<h2>تورهای شما</h2>
<div id="tours" class="muted">در حال دریافت...</div>
</section>

<section class="card">
<h2>رزروهای شما</h2>
<div id="bookings" class="muted">در حال دریافت...</div>
</section>
</main>

<script>
const API='/api/';
let csrf='';
let currentAgency=null;

const $=id=>document.getElementById(id);

function escapeHTML(value){
 return String(value??'').replace(/[&<>"']/g,c=>({
 '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
 }[c]));
}

async function requestJSON(url,options={}){
 const response=await fetch(url,{
  credentials:'same-origin',
  cache:'no-store',
  ...options
 });
 const text=await response.text();
 let data;
 try{data=JSON.parse(text)}
 catch(e){throw new Error('پاسخ سرور معتبر نیست. وضعیت HTTP: '+response.status)}
 if(!response.ok||data.success===false){
  throw new Error(data.error||'خطای ارتباط با سرور');
 }
 return data;
}

async function load(){
 const d=await requestJSON(API+'agency.php');
 if(!d.agency||!d.csrf)throw new Error('اطلاعات نشست آژانس ناقص است');
 csrf=d.csrf;
 currentAgency=d.agency;

 $('agency').textContent=
  (d.agency.name||'آژانس')+' — شناسه ورود: '+d.agency.loginId;

 renderTours(d.tours||[]);
 renderBookings(d.bookings||[]);
}

function renderTours(items){
 $('tours').innerHTML=items.length?items.map(t=>{
  const status=t.approval_status||'pending';
  const labels={
   pending:'در انتظار تأیید',
   approved:'تأیید شده',
   rejected:'رد شده'
  };
  return `<div class="item">
   <strong>${escapeHTML(t.name||'بدون نام')}</strong>
   <p class="muted">${escapeHTML(t.destination||'')}</p>
   <span class="status ${status}">${labels[status]||escapeHTML(status)}</span>
   <p class="muted">قیمت: ${Number(t.price||0).toLocaleString('fa-IR')} تومان | ظرفیت: ${escapeHTML(t.capacity)}</p>
   ${status==='rejected'&&t.rejection_reason?
    '<p class="muted">دلیل رد: '+escapeHTML(t.rejection_reason)+'</p>':''}
  </div>`;
 }).join(''):'هنوز توری ثبت نکرده‌اید.';
}

function renderBookings(items){
 $('bookings').innerHTML=items.length?items.map(b=>
  `<div class="item">
   <strong>رزرو ${escapeHTML(b.id||'')}</strong>
   <p class="muted">تور: ${escapeHTML(b.tourId||'')} | تعداد: ${escapeHTML(b.count??'نامشخص')}</p>
  </div>`
 ).join(''):'هنوز رزروی ثبت نشده است.';
}

function previewFiles(input,container){
 const files=Array.from(input.files||[]);
 container.innerHTML='';
 files.forEach(file=>{
  if(!file.type.startsWith('image/'))return;
  const img=document.createElement('img');
  img.alt='پیش‌نمایش تصویر';
  img.src=URL.createObjectURL(file);
  container.appendChild(img);
 });
}

$('mainImage').addEventListener('change',()=>{
 previewFiles($('mainImage'),$('mainPreview'));
});

$('galleryImages').addEventListener('change',()=>{
 const input=$('galleryImages');
 if(input.files.length>5){
  alert('حداکثر ۵ تصویر برای گالری مجاز است.');
  input.value='';
 }
 previewFiles(input,$('galleryPreview'));
});

async function uploadImage(file){
 const fd=new FormData();
 fd.append('image',file);

 const d=await requestJSON(API+'upload.php',{
  method:'POST',
  headers:{'X-CSRF-Token':csrf},
  body:fd
 });

 if(!d.url)throw new Error('آدرس تصویر از سرور دریافت نشد');
 return d.url;
}

$('tourForm').addEventListener('submit',async e=>{
 e.preventDefault();

 const button=$('submitTour');
 const msg=$('msg');
 const form=e.currentTarget;
 const data=new FormData(form);

 const main=$('mainImage').files[0];
 const gallery=Array.from($('galleryImages').files);

 if(!main){msg.textContent='تصویر اصلی را انتخاب کنید.';return}
 if(gallery.length>5){msg.textContent='حداکثر ۵ عکس گالری مجاز است.';return}

 const files=[main,...gallery];
 if(files.some(f=>f.size>8*1024*1024)){
  msg.textContent='حجم هیچ تصویری نباید بیشتر از ۸ مگابایت باشد.';
  return;
 }

 button.disabled=true;
 msg.textContent='در حال آپلود تصاویر...';

 try{
  const image=await uploadImage(main);
  const galleryUrls=[];

  for(let i=0;i<gallery.length;i++){
   msg.textContent='در حال آپلود تصویر '+(i+1)+' از '+gallery.length+'...';
   galleryUrls.push(await uploadImage(gallery[i]));
  }

  const item={
   name:String(data.get('name')).trim(),
   destination:String(data.get('destination')).trim(),
   type:data.get('type'),
   price:Number(data.get('price')),
   capacity:Number(data.get('capacity')),
   start:data.get('start')||'',
   end:data.get('end')||'',
   features:String(data.get('features')||''),
   description:String(data.get('description')||''),
   image,
   gallery:galleryUrls
  };

  msg.textContent='در حال ثبت تور...';

  await requestJSON(API+'agency.php',{
   method:'POST',
   headers:{
    'Content-Type':'application/json',
    'X-CSRF-Token':csrf
   },
   body:JSON.stringify({
    action:'create_tour',
    ...item
   })
  });

  msg.textContent='تور با موفقیت ثبت شد و در انتظار تأیید مدیریت است.';
  form.reset();
  $('mainPreview').innerHTML='';
  $('galleryPreview').innerHTML='';
  await load();

 }catch(error){
  msg.textContent='خطا: '+error.message;
 }finally{
  button.disabled=false;
 }
});

$('logout').addEventListener('click',async()=>{
 try{
  await requestJSON(API+'agency-auth.php',{
   method:'POST',
   headers:{
    'Content-Type':'application/json',
    'X-CSRF-Token':csrf
   },
   body:JSON.stringify({action:'logout'})
  });
 }catch(e){}
 location.href='/agency/';
});

load().catch(error=>{
 $('agency').textContent='خطا: '+error.message;
 if(error.message.includes('ابتدا وارد حساب'))location.href='/agency/';
});
</script>
</body>
</html>
