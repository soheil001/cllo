
<?php
require_once __DIR__ . '/auth_common.php';

$agency = ot_require_agency();

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    header('Allow: POST');
    ot_json(['success'=>false,'error'=>'Method not allowed'],405);
}

ot_require_csrf($agency['csrf']);

if (!isset($_FILES['image'])) {
    ot_json(['success'=>false,'error'=>'تصویری انتخاب نشده است'],400);
}

$file = $_FILES['image'];

if ($file['error'] !== UPLOAD_ERR_OK) {
    ot_json(['success'=>false,'error'=>'خطا در دریافت تصویر'],400);
}

$maxSize = 8 * 1024 * 1024;

if ($file['size'] <= 0 || $file['size'] > $maxSize) {
    ot_json(['success'=>false,'error'=>'حجم تصویر باید حداکثر ۸ مگابایت باشد'],400);
}

$tmp = $file['tmp_name'];

if (!is_uploaded_file($tmp)) {
    ot_json(['success'=>false,'error'=>'فایل ارسالی معتبر نیست'],400);
}

$info = @getimagesize($tmp);

if (!$info) {
    ot_json(['success'=>false,'error'=>'فایل تصویر معتبر نیست'],400);
}

$finfo = new finfo(FILEINFO_MIME_TYPE);
$mime = $finfo->file($tmp);

$allowed = [
    'image/jpeg' => 'jpg',
    'image/png'  => 'png',
    'image/webp' => 'webp'
];

if (!isset($allowed[$mime]) || $info['mime'] !== $mime) {
    ot_json(['success'=>false,'error'=>'فقط تصاویر JPG، PNG و WEBP مجاز هستند'],400);
}

if ($info[0] > 6000 || $info[1] > 6000) {
    ot_json(['success'=>false,'error'=>'ابعاد تصویر بیش از حد مجاز است'],400);
}

$directory = __DIR__ . '/../uploads/tours/';

if (!is_dir($directory) || !is_writable($directory)) {
    ot_json(['success'=>false,'error'=>'پوشه ذخیره تصاویر قابل نوشتن نیست'],500);
}

$filename = bin2hex(random_bytes(20)) . '.' . $allowed[$mime];
$destination = $directory . $filename;

if (!move_uploaded_file($tmp, $destination)) {
    ot_json(['success'=>false,'error'=>'ذخیره تصویر انجام نشد'],500);
}

@chmod($destination, 0644);

ot_json([
    'success'=>true,
    'url'=>'/uploads/tours/' . $filename,
    'message'=>'تصویر با موفقیت آپلود شد'
]);
