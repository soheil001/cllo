:root{--navy:#081a33;--navy2:#102b4e;--gold:#f2b632;--gold2:#ffd98a;--ink:#eaf1fb;--muted:#a9b9d0;
--glass:rgba(255,255,255,.07);--glass2:rgba(255,255,255,.12);--stroke:rgba(255,255,255,.18);--hi:rgba(255,255,255,.35)}
*{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;color:var(--ink);font-family:'Vazirmatn',Tahoma,sans-serif;line-height:1.9;min-height:100vh;
background:var(--navy);position:relative;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;z-index:-2;
background:
radial-gradient(900px 600px at 85% -5%,rgba(242,182,50,.20),transparent 60%),
radial-gradient(800px 700px at 5% 25%,rgba(56,120,220,.30),transparent 60%),
radial-gradient(900px 700px at 70% 85%,rgba(110,70,210,.22),transparent 60%),
linear-gradient(180deg,#071428,#0b2243 55%,#071428)}
