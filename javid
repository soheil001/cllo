.more i{font-style:normal;transition:transform .3s}.card.open .more i{transform:rotate(180deg)}
.card.hide{display:none}
.empty{display:none;text-align:center;padding:40px;border-radius:20px;color:var(--muted)}
.note{margin-top:28px;border-radius:18px;padding:16px 22px;color:#c3d1e5;font-size:.9rem}.note strong{color:var(--gold2)}
