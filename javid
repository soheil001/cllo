.card h3{margin:0;font-size:1.06rem;font-weight:800;line-height:1.6;color:#fff}
.meta{margin:14px 0 10px;position:relative}
.meta span{display:inline-block;font-size:.76rem;padding:2px 12px;border-radius:99px;background:rgba(255,255,255,.08);border:1px solid var(--stroke);color:#cfdcee}
.topics{list-style:none;margin:0;padding:0;position:relative;max-height:158px;overflow:hidden;transition:max-height .5s ease;
