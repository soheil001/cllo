.cta{padding:30px 0 80px}
.cta-panel{border-radius:30px;padding:42px 46px;display:flex;align-items:center;justify-content:space-between;gap:24px;position:relative;overflow:hidden;
background:linear-gradient(120deg,rgba(242,182,50,.20),rgba(255,255,255,.06) 55%,rgba(80,130,230,.18))}
.cta-panel:after{content:"↗";font-size:10rem;line-height:1;position:absolute;left:28px;bottom:-34px;color:#ffffff10;font-weight:800}
.cta h2{font-size:1.7rem;margin:0 0 6px}.cta p{margin:0;color:#d0dcee}.cta .btn{position:relative;z-index:1;white-space:nowrap}
footer{padding:0 0 28px}
.footer-inner{display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;padding:18px 26px;border-radius:18px;color:var(--muted);font-size:.86rem}
