@media(max-width:980px){.course-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-inner{padding:44px 30px}.hero-stats{display:none}.hero{padding-left:0}}
@media(max-width:700px){nav{display:none}.nav{min-height:60px}.hero{min-height:400px;border-radius:24px}.hero-inner{padding:38px 22px}
.trust{grid-template-columns:repeat(2,1fr);margin-top:-30px;padding:18px 12px}.trust-item+.trust-item:before{display:none}.trust-item{font-size:.82rem}
.section{padding:60px 0 24px}.course-grid{grid-template-columns:1fr;gap:16px}.cta-panel{padding:28px 22px;flex-direction:column;align-items:flex-start}.cta h2{font-size:1.35rem}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
@supports not ((backdrop-filter:blur(1px)) or (-webkit-backdrop-filter:blur(1px))){.glass,.card{background:rgba(20,45,84,.88)}}
</style>
