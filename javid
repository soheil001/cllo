.o1{width:340px;height:340px;background:rgba(242,182,50,.35);left:-60px;top:-90px}
.o2{width:380px;height:380px;background:rgba(70,130,240,.40);left:25%;bottom:-170px}
.hero-inner{position:relative;padding:56px 54px 84px;max-width:700px}
.hero-stats{position:relative;margin-bottom:40px;display:grid;gap:16px;width:250px;flex:none}
.stat{border-radius:20px;padding:16px 22px;display:flex;flex-direction:column}
.stat:nth-child(2){margin-right:34px}
.stat b{font-size:2rem;line-height:1.4;font-weight:800;background:linear-gradient(90deg,var(--gold2),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}
.stat span{font-size:.88rem;color:#cfdcee}
.eyebrow{display:inline-flex;align-items:center;gap:9px;color:var(--gold2);font-weight:700;font-size:.9rem;padding:6px 16px;border-radius:99px;background:rgba(242,182,50,.12);border:1px solid rgba(242,182,50,.35);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px)}
.eyebrow:before{content:"";width:7px;height:7px;border-radius:50%;background:var(--gold);box-shadow:0 0 10px var(--gold)}
h1{font-size:clamp(2.1rem,4.6vw,3.7rem);line-height:1.35;margin:18px 0 12px;font-weight:800;letter-spacing:-.5px}
h1 span{white-space:nowrap;background:linear-gradient(90deg,var(--gold2),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{font-size:1.1rem;color:#d9e4f4;max-width:620px;margin:0 0 28px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.btn{border:0;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 26px;border-radius:14px;font:inherit;font-weight:700;cursor:pointer;transition:.25s}
.btn-gold{background:linear-gradient(135deg,var(--gold2),var(--gold));color:#0d2240;box-shadow:0 10px 26px rgba(242,182,50,.35),inset 0 1px 0 #fff9}
