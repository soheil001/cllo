.trust{margin-top:-46px;position:relative;z-index:2;border-radius:22px;padding:20px 26px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px;width:min(1080px,94%);margin-inline:auto}
.trust-item{display:flex;align-items:center;justify-content:center;gap:12px;font-size:.92rem;font-weight:600;position:relative}
